{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "description": "__MSG_description__",
  "version": "0.1.0",
  "minimum_chrome_version": "121",
  "default_locale": "en",
  "permissions": ["tabs", "activeTab", "scripting", "favicon", "storage"],
  "options_ui": { "page": "options.html" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "__MSG_name__",
    "default_icon": { "16": "icons/icon-16.png", "20": "icons/icon-20.png", "24": "icons/icon-24.png", "32": "icons/icon-32.png" }
  },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+F" } },
    "previous-tab": { "suggested_key": { "default": "Alt+Z" }, "description": "__MSG_cmdPrevious__" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [
    { "resources": ["search.html", "search.js", "search.css", "fuzzy.js", "keys.js"], "matches": ["<all_urls>"], "use_dynamic_url": true }
  ]
}

---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Playground from '../../components/Playground.astro';
import Moments from '../../components/Moments.astro';
import Keys from '../../components/Keys.astro';
import Privacy from '../../components/Privacy.astro';
import Install from '../../components/Install.astro';
import { useT, localePath } from '../../i18n/index.js';
import { localeStaticPaths } from '../../i18n/locales.js';
import { storeUrls, SUPPORT_EMAIL, COMPANY, COMPANY_URL } from '../../config.js';

export const getStaticPaths = localeStaticPaths;

const { t, locale } = useT(Astro.currentLocale);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'TabNow',
  description: t('meta.homeDescription'),
  applicationCategory: 'BrowserApplication',
  operatingSystem: 'Chrome 121 or newer, Edge, Brave, Opera, Vivaldi, Arc',
  url: new URL(localePath(locale, '/'), Astro.site).href,
  license: 'https://opensource.org/licenses/MIT',
  isAccessibleForFree: true,
  offers: storeUrls.map((url) => ({ '@type': 'Offer', price: '0', priceCurrency: 'EUR', url })),
  downloadUrl: storeUrls,
  installUrl: storeUrls,
  author: { '@type': 'Organization', name: COMPANY, url: COMPANY_URL, email: SUPPORT_EMAIL },
};
---

<Base title={t('meta.homeTitle')} description={t('meta.homeDescription')} path="/" jsonLd={jsonLd} home>
  <Hero />
  <Playground />
  <Moments />
  <Privacy />
  <Keys />
  <Install />
</Base>

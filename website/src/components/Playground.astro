---
import { useT } from '../i18n/index.js';
const { t } = useT(Astro.currentLocale);
// Strings the script needs; everything the visitor reads that is not made-up page content lives in en.json.
const s = {
  windowName: t('playground.windowName', { n: '{n}' }),
  windowSwitch: t('playground.windowSwitch', { n: '{n}' }),
  newTab: t('playground.newTab'),
  closeTab: t('playground.closeTab'),
  panel: t('playground.panel'),
  allBookmarks: t('playground.allBookmarks'),
  keyAlt: t('playground.keyAlt'),
  keyMac: t('playground.keyMac'),
  lineMac: t('playground.lineMac'),
  hintMac: t('playground.hintMac'),
  labelMac: t('playground.labelMac'),
};
---

<section class="pgs" id="try" aria-labelledby="try-h" data-pg data-s={JSON.stringify(s)}>
  <div class="pgs-head">
    <h2 id="try-h">{t('playground.titleA')} <em>{t('playground.titleB')}</em></h2>
    <p class="pgs-line" data-line>{t('playground.line')}</p>
  </div>

  <div class="pg-win" tabindex="0" role="application" aria-label={t('playground.label')} data-win>
    <div class="pg-top">
      <div class="pg-dots" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="pg-strip" data-strip></div>
      <button class="pg-ib pg-plus" type="button" tabindex="-1" aria-label={t('playground.newTab')} data-newtab>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <button class="pg-winpill" type="button" tabindex="-1" data-winpill></button>
    </div>
    <div class="pg-bar">
      <button class="pg-ib" type="button" tabindex="-1" aria-label={t('playground.back')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      </button>
      <button class="pg-ib dim" type="button" tabindex="-1" aria-label={t('playground.forward')}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </button>
      <button class="pg-ib" type="button" tabindex="-1" aria-label={t('playground.reload')}>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9M20 4v5h-5"/></svg>
      </button>
      <div class="pg-omni" role="textbox" aria-readonly="true" aria-label={t('playground.address')}>
        <svg class="lock" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>
        <span class="url" data-url></span>
        <svg class="star" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-label={t('playground.bookmark')}><path d="m12 3 2.7 5.6 6.1.8-4.4 4.3 1 6.1L12 16.9 6.6 19.8l1-6.1L3.2 9.4l6.1-.8z"/></svg>
      </div>
      <button class="pg-ext" type="button" tabindex="-1" title={t('playground.extension')} aria-label={t('playground.button')} data-open>
        <img src="/icon-128.png" width="22" height="22" alt="" />
      </button>
      <span class="pg-me" aria-hidden="true"></span>
    </div>
    <div class="pg-marks" data-marks></div>
    <div class="pg-page" data-page></div>
    <div class="pg-hint" data-hint aria-hidden="true">
      <span data-hint-text>{t('playground.hint')}</span>
    </div>
    <div class="pg-card" data-card hidden></div>
  </div>

  <div class="pgs-under">
    <button class="btn" type="button" data-open>
      {t('playground.button')}
      <span class="keys"><kbd data-mod>{t('playground.keyAlt')}</kbd><kbd>E</kbd></span>
    </button>
  </div>
</section>

<script>
  import '../playground/playground.js';
</script>

<style is:global>
  .pgs { padding: 72px 0 130px; text-align: center; }
  .pgs-head h2 { margin: 0; font: 400 96px/1 "Instrument Serif", serif; letter-spacing: -.015em; }
  .pgs-head h2 em { font-style: italic; color: var(--hit); }
  .pgs-line { margin: 22px 0 0; font-size: 20px; color: var(--muted); }
  .pgs-under { margin-top: 34px; display: flex; justify-content: center; }
  .pgs-under .btn { height: 44px; padding: 0 12px 0 20px; font-size: 15px; gap: 14px; }
  .pgs-under .keys { display: inline-flex; gap: 4px; }
  .pgs-under kbd { background: color-mix(in srgb, var(--on-hit) 22%, transparent); color: var(--on-hit); }

  /* ---- the fake browser ---- */
  .pg-win {
    --f-frame: #dfe3e9; --f-bar: #fff; --f-omni: #eff1f5; --f-sep: rgb(15 20 30 / .18); --f-ink: #1f2329; --f-sub: #5f6672;
    --f-line: rgb(15 20 30 / .12); --f-hover: rgb(15 20 30 / .07); --f-shadow: 0 30px 80px rgb(15 20 30 / .16);
    --p-bg: #fff; --p-b1: #eef0f4; --p-b2: #e1e5eb; --p-b3: #cfd5de; --p-ink: #2a2f38;
    position: relative; width: 1280px; height: 700px; margin: 64px auto 0; border-radius: 12px; overflow: hidden; text-align: left;
    background: var(--f-frame); color: var(--f-ink); font: 400 13px/1.3 "IBM Plex Sans", system-ui, sans-serif; outline: 0; user-select: none;
    box-shadow: var(--f-shadow), 0 0 0 1px var(--f-line); transition: box-shadow .25s;
  }
  [data-theme="dark"] .pg-win {
    --f-frame: #191d23; --f-bar: #262b34; --f-omni: #1a1e25; --f-sep: rgb(255 255 255 / .2); --f-ink: #e6e8ec; --f-sub: #a0a7b4;
    --f-line: rgb(255 255 255 / .09); --f-hover: rgb(255 255 255 / .08); --f-shadow: 0 30px 80px rgb(0 0 0 / .45);
    --p-bg: #1b1f26; --p-b1: #262b34; --p-b2: #2f3540; --p-b3: #3b4250; --p-ink: #d9dce2;
  }
  .pg-win:focus-within { box-shadow: var(--f-shadow), 0 0 0 1px color-mix(in srgb, var(--hit) 70%, transparent), 0 0 0 5px color-mix(in srgb, var(--hit) 16%, transparent); }
  .pg-win svg { flex: none; }
  .pg-win button { font: inherit; color: inherit; }

  /* tab strip */
  .pg-top { position: relative; height: 42px; display: flex; align-items: flex-end; padding: 0 8px 0 0; }
  .pg-dots { align-self: center; display: flex; gap: 8px; padding: 0 20px 0 16px; }
  .pg-dots i { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
  .pg-dots i:nth-child(2) { background: #febc2e; }
  .pg-dots i:nth-child(3) { background: #28c840; }
  [data-theme="dark"] .pg-dots i { filter: saturate(.8) brightness(.9); }
  .pg-strip { flex: 0 1 auto; min-width: 0; display: flex; align-items: flex-end; height: 36px; }
  .pg-tab {
    position: relative; flex: 0 1 240px; min-width: 26px; height: 32px; container-type: inline-size; border: 0; background: none; padding: 0; cursor: default;
    color: var(--f-sub); text-align: left;
  }
  .pg-tab .in { position: absolute; inset: 0 1px 0; display: flex; align-items: center; gap: 8px; padding: 0 9px; border-radius: 8px 8px 0 0; overflow: hidden; }
  .pg-tab:hover:not(.on) .in { background: var(--f-hover); border-radius: 8px; inset: 0 1px 3px; }
  .pg-tab .sep { position: absolute; left: 0; top: 7px; bottom: 10px; width: 1px; background: var(--f-sep); }
  .pg-tab:first-child .sep, .pg-tab.on .sep, .pg-tab.on + .pg-tab .sep, .pg-tab:hover .sep, .pg-tab:hover + .pg-tab .sep { opacity: 0; }
  .pg-tab img { flex: none; width: 16px; height: 16px; border-radius: 4px; display: block; }
  [data-theme="dark"] .pg-tab img, [data-theme="dark"] .pg-mk img { box-shadow: 0 0 0 1px rgb(255 255 255 / .14); }
  .pg-tab .ttl { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 12px; -webkit-mask-image: linear-gradient(90deg, #000 calc(100% - 14px), transparent); mask-image: linear-gradient(90deg, #000 calc(100% - 14px), transparent); }
  .pg-tab .x { flex: none; width: 18px; height: 18px; margin-right: -3px; display: grid; place-items: center; border-radius: 50%; color: var(--f-sub); }
  .pg-tab .x:hover { background: var(--f-hover); }
  .pg-tab:not(:hover):not(.on) .x { display: none; }
  .pg-tab.on { z-index: 2; min-width: 76px; color: var(--f-ink); height: 36px; }
  .pg-tab.on .in { background: var(--f-bar); inset: 0 1px 0; border-radius: 9px 9px 0 0; }
  .pg-tab.on::before, .pg-tab.on::after { content: ""; position: absolute; bottom: 0; width: 9px; height: 9px; pointer-events: none; }
  .pg-tab.on::before { right: 100%; margin-right: -1px; background: radial-gradient(circle at 0 0, transparent 8.5px, var(--f-bar) 9px); }
  .pg-tab.on::after { left: 100%; margin-left: -1px; background: radial-gradient(circle at 100% 0, transparent 8.5px, var(--f-bar) 9px); }
  @container (max-width: 92px) { .pg-tab:not(.on) .x { display: none; } }
  @container (max-width: 64px) { .pg-tab .ttl { display: none; } .pg-tab:not(.on) .in { justify-content: center; padding: 0; } }
  .pg-tab.on .x { display: grid; }
  .pg-ib { flex: none; width: 30px; height: 30px; display: grid; place-items: center; border: 0; border-radius: 50%; background: none; color: var(--f-sub); cursor: default; }
  .pg-ib:hover { background: var(--f-hover); }
  .pg-ib.dim { opacity: .45; }
  .pg-plus { margin: 0 0 3px 6px; width: 28px; height: 28px; }
  .pg-winpill {
    margin: 0 0 5px auto; height: 26px; display: inline-flex; align-items: center; gap: 7px; padding: 0 10px 0 8px; border: 0; border-radius: 13px; cursor: pointer;
    background: var(--f-hover); color: var(--f-ink); font-size: 12px; font-weight: 500; white-space: nowrap;
  }
  .pg-winpill:hover { background: color-mix(in srgb, var(--f-ink) 14%, transparent); }
  .pg-winpill .wi { width: 14px; height: 14px; background: var(--win) center / contain no-repeat; }
  .pg-winpill .of { color: var(--f-sub); font-weight: 400; }

  /* toolbar and address bar */
  .pg-bar { position: relative; z-index: 1; height: 42px; display: flex; align-items: center; gap: 2px; padding: 0 10px 2px 8px; background: var(--f-bar); }
  .pg-omni { flex: 1; height: 32px; margin: 0 8px; display: flex; align-items: center; gap: 10px; padding: 0 12px; border-radius: 16px; background: var(--f-omni); color: var(--f-sub); min-width: 0; }
  .pg-omni .url { flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 13.5px; }
  .pg-omni .url b { font-weight: 400; color: var(--f-ink); }
  .pg-omni .star { margin-left: auto; }
  .pg-ext { flex: none; width: 30px; height: 30px; display: grid; place-items: center; border: 0; border-radius: 50%; background: none; cursor: pointer; }
  .pg-ext:hover { background: var(--f-hover); }
  .pg-ext img { border-radius: 5px; display: block; }
  .pg-me { flex: none; width: 24px; height: 24px; margin: 0 4px 0 6px; border-radius: 50%; background: linear-gradient(135deg, #8aa4d6, #5a74b0); }
  [data-theme="dark"] .pg-me { background: linear-gradient(135deg, #5d77ad, #3b5287); }

  /* bookmarks bar */
  .pg-marks { position: relative; z-index: 1; height: 32px; display: flex; align-items: center; gap: 2px; padding: 0 10px; background: var(--f-bar); border-bottom: 1px solid var(--f-line); }
  .pg-mk { display: inline-flex; align-items: center; gap: 6px; height: 24px; max-width: 150px; padding: 0 8px; border: 0; border-radius: 6px; background: none; cursor: pointer; font-size: 12px; color: var(--f-ink); }
  .pg-mk:hover { background: var(--f-hover); }
  .pg-mk img { width: 14px; height: 14px; border-radius: 3px; }
  .pg-mk span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pg-mk.all { margin-left: auto; cursor: default; }

  /* page area */
  .pg-page { position: relative; height: 584px; overflow: hidden; background: var(--p-bg); color: var(--p-ink); }
  .pg-hint {
    position: absolute; z-index: 4; left: 50%; bottom: 22px; transform: translateX(-50%); padding: 8px 14px; border-radius: 20px; pointer-events: none;
    background: var(--f-ink); color: var(--f-bar); font-size: 13px; font-weight: 500; transition: opacity .25s, transform .25s; box-shadow: 0 6px 20px rgb(0 0 0 / .18);
  }
  .pg-win:focus-within .pg-hint { opacity: 0; transform: translate(-50%, 6px); }
  .pg-card { position: absolute; z-index: 6; top: 40px; width: 260px; padding: 10px 12px; border-radius: 10px; background: var(--f-bar); box-shadow: 0 8px 28px rgb(0 0 0 / .18), 0 0 0 1px var(--f-line); pointer-events: none; }
  .pg-card[hidden] { display: none; }
  .pg-card b { display: block; font-weight: 500; font-size: 12.5px; line-height: 1.35; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .pg-card span { display: block; margin-top: 4px; font-size: 12px; color: var(--f-sub); }

  /* TabNow overlay: the same layers background.js builds */
  .pg-ov { position: absolute; z-index: 5; left: 0; right: 0; top: 116px; bottom: 0; }
  .pg-ov > * { position: absolute; }
  .pg-ov .scrim { inset: 0; }
  .pg-ov .box { left: 50%; top: 12%; transform: translateX(-50%); width: 640px; height: 480px; max-height: 92%; border-radius: 16px; }
  .pg-ov .frost { box-shadow: 0 30px 80px rgb(0 0 0 / .25); }
  .pg-ov iframe { border: 0; background: transparent; }

  /* mock pages: real text, built in pages.js */
  .pg-page { --pq-line: var(--f-line); --pq-sub: var(--f-sub); --pq-green: #2da44e; --pq-red: #d1242f; --pq-blue: #0969da; font-size: 13px; line-height: 1.45; }
  [data-theme="dark"] .pg-page { --pq-green: #3fb950; --pq-red: #f85149; --pq-blue: #58a6ff; }
  .pg-page p { margin: 0; }
  .pg-page h1, .pg-page h2, .pg-page h3 { margin: 0; font-family: "IBM Plex Sans", sans-serif; }
  .pg-page pre code { background: none; padding: 0; }
  .pg-page code, .pg-page pre { font-family: "IBM Plex Mono", ui-monospace, monospace; }
  .pg-page .grow, .pq-grow { flex: 1; }
  .pg-page em { font-style: normal; }
  .pq-chip { flex: none; width: 24px; height: 24px; border-radius: 7px; display: inline-grid; place-items: center; font: 600 12px/1 "IBM Plex Sans", sans-serif; }
  .pq-chip.rd { border-radius: 50%; } .pq-chip.big { width: 32px; height: 32px; font-size: 14px; } .pq-chip.sq { border-radius: 5px; }
  .pq-av { flex: none; width: 22px; height: 22px; border-radius: 50%; display: inline-grid; place-items: center; font: 600 11px/1 "IBM Plex Sans", sans-serif; color: #fff; background: #5b7bd5; vertical-align: middle; }
  .pq-av.a1 { background: #8957e5; } .pq-av.a2 { background: #d1693a; } .pq-av.a3 { background: #2f9e75; } .pq-av.a4 { background: #c2487d; } .pq-av.a5 { background: #4a8fb8; }
  .pg-page .lb { font-style: normal; padding: 1px 8px; border-radius: 10px; font-size: 11px; font-weight: 500; background: color-mix(in srgb, var(--c, #888) 18%, transparent); color: color-mix(in srgb, var(--c, #888) 70%, var(--p-ink)); }
  .pg-page .sm { color: var(--pq-sub); font-size: 13px; } .pg-page .share { padding: 6px 14px; border-radius: 16px; background: #c2e7ff; color: #001d35; font-weight: 500; }
  [data-theme="dark"] .pg-page .share { background: #2c4a6b; color: #d6e8ff; }

  .pq-top { height: 52px; display: flex; align-items: center; gap: 12px; padding: 0 28px; border-bottom: 1px solid var(--pq-line); }
  .pq-top b { font-weight: 600; font-size: 15px; } .pq-top .pq-sm { margin-left: 18px; color: var(--pq-sub); }
  .pp-new { display: grid; place-items: center; height: 532px; align-content: center; gap: 22px; }
  .pp-new .bg1 { width: 120px; height: 34px; border-radius: 8px; background: var(--p-b2); }
  .pp-new .box { width: 560px; height: 46px; border-radius: 23px; background: var(--p-b1); }

  /* github */
  .pq-ghh { background: var(--p-b1); border-bottom: 1px solid var(--pq-line); }
  .pq-ghh .r1 { height: 52px; display: flex; align-items: center; gap: 12px; padding: 0 28px; }
  .pq-ghh .repo { font-size: 14px; color: var(--pq-blue); } .pq-ghh .repo b { font-weight: 600; }
  .pq-ghh .find { padding: 5px 12px; border: 1px solid var(--pq-line); border-radius: 6px; color: var(--pq-sub); font-size: 12px; background: var(--p-bg); }
  .pq-ghh .r2 { display: flex; gap: 4px; padding: 0 22px; }
  .pq-ghh .r2 span { padding: 8px 10px 10px; white-space: nowrap; }
  .pq-ghh .r2 span.on { font-weight: 600; box-shadow: inset 0 -2px 0 #fd8c73; }
  .pq-ghh em, .pq-ghb em { margin-left: 6px; padding: 0 7px; border-radius: 10px; background: var(--p-b3); font-size: 11px; font-weight: 500; }
  .pq-ghb { padding: 22px 28px 0; max-width: 1180px; }
  .pq-ghb h1 { font-size: 28px; font-weight: 400; letter-spacing: -.01em; } .pq-ghb h1 s { text-decoration: none; color: var(--pq-sub); }
  .pq-ghb .meta { display: flex; align-items: center; gap: 12px; margin: 12px 0 16px; color: var(--pq-sub); }
  .pq-ghb .meta b { color: var(--p-ink); }
  .pq-ghb .badge { padding: 5px 14px; border-radius: 16px; background: var(--pq-green); color: #fff; font-weight: 600; }
  .pq-ghb code { padding: 1px 6px; border-radius: 6px; background: color-mix(in srgb, var(--pq-blue) 14%, transparent); color: var(--pq-blue); font-size: 12px; }
  .pq-ghb .tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--pq-line); margin-bottom: 18px; }
  .pq-ghb .tabs span { padding: 8px 14px; } .pq-ghb .tabs .on { font-weight: 600; box-shadow: inset 0 -2px 0 #fd8c73; }
  .pq-ghb .cols { display: grid; grid-template-columns: 1fr 250px; gap: 32px; }
  .pq-ghb .cmt { display: flex; gap: 12px; margin-bottom: 16px; }
  .pq-ghb .cmt .pq-av { width: 36px; height: 36px; font-size: 14px; }
  .pq-ghb .cmt > div { flex: 1; border: 1px solid var(--pq-line); border-radius: 8px; overflow: hidden; }
  .pq-ghb .ch { padding: 8px 14px; background: var(--p-b1); border-bottom: 1px solid var(--pq-line); color: var(--pq-sub); } .pq-ghb .ch b { color: var(--p-ink); }
  .pq-ghb .cmt p { padding: 10px 14px 0; } .pq-ghb .cmt p:last-child { padding-bottom: 12px; }
  .pq-ghb .diff { border: 1px solid var(--pq-line); border-radius: 8px; overflow: hidden; }
  .pq-ghb .fh { display: flex; justify-content: space-between; padding: 8px 14px; background: var(--p-b1); border-bottom: 1px solid var(--pq-line); font: 500 12.5px "IBM Plex Mono", monospace; }
  .pq-ghb .fh i { font-style: normal; } .pq-ghb .fh .p { color: var(--pq-green); } .pq-ghb .fh .m { color: var(--pq-red); }
  .pq-ghb .r { display: flex; white-space: pre; font-size: 12px; line-height: 22px; }
  .pq-ghb .r u { flex: none; width: 48px; text-align: right; padding-right: 12px; text-decoration: none; color: var(--pq-sub); font: 12px/22px "IBM Plex Mono", monospace; }
  .pq-ghb .r.h { background: color-mix(in srgb, var(--pq-blue) 12%, transparent); color: var(--pq-blue); padding-left: 14px; font-family: "IBM Plex Mono", monospace; }
  .pq-ghb .r.a { background: color-mix(in srgb, var(--pq-green) 14%, transparent); } .pq-ghb .r.a u { background: color-mix(in srgb, var(--pq-green) 24%, transparent); }
  .pq-ghb .r.x { background: color-mix(in srgb, var(--pq-red) 12%, transparent); } .pq-ghb .r.x u { background: color-mix(in srgb, var(--pq-red) 22%, transparent); }
  .pq-ghb .side > div { padding: 0 0 14px; margin-bottom: 14px; border-bottom: 1px solid var(--pq-line); color: var(--pq-sub); }
  .pq-ghb .side b { font-weight: 600; font-size: 12px; } .pq-ghb .side p { margin-top: 8px; color: var(--p-ink); display: flex; align-items: center; gap: 8px; }
  .pq-ghb .side .ok { margin-left: auto; font-style: normal; color: var(--pq-green); font-size: 12px; }
  .pq-list { border: 1px solid var(--pq-line); border-radius: 8px; overflow: hidden; }
  .pq-list .lh { display: flex; gap: 20px; padding: 12px 16px; background: var(--p-b1); border-bottom: 1px solid var(--pq-line); color: var(--pq-sub); }
  .pq-list .lh b { color: var(--p-ink); }
  .pq-list .li { display: flex; gap: 12px; align-items: flex-start; padding: 11px 16px; border-bottom: 1px solid var(--pq-line); }
  .pq-list .li:last-child { border: 0; }
  .pq-list .dot { flex: none; width: 14px; height: 14px; margin-top: 3px; border-radius: 50%; border: 2px solid var(--pq-green); }
  .pq-list .li b { font-weight: 600; font-size: 14px; } .pq-list .li p { margin-top: 3px; color: var(--pq-sub); font-size: 12px; }
  .pq-list .cm { color: var(--pq-sub); }

  /* gmail */
  .pq-gm { height: 584px; display: flex; flex-direction: column; background: #f6f8fc; color: #1f1f1f; }
  .pq-gm .top { flex: none; height: 56px; display: flex; align-items: center; gap: 22px; padding: 0 20px; }

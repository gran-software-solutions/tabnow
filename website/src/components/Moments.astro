---
import { useT } from '../i18n/index.js';
import Moment from './Moment.astro';
const { t } = useT(Astro.currentLocale);
const glass = '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>';
---


<Moment k="fuzzy" id="features">
  <div class="ov big" id="mFuzzy" aria-hidden="true">
    <div class="q"><Fragment set:html={glass} /><span class="typed" id="mFuzzyQ"></span><span class="n" id="mFuzzyN"></span></div>
    <ul id="mFuzzyRows"></ul>
    <div class="foot">
      <span class="k"><kbd>↑</kbd><kbd>↓</kbd> {t('demo.navigate')}</span>
      <span class="k"><kbd>↵</kbd> {t('demo.open')}</span>
      <span class="k"><kbd>{t('key.ctrl')}</kbd><kbd>⌫</kbd> {t('demo.closeTab')}</span>
      <span class="k"><kbd>/</kbd> {t('demo.scopes')}</span>
      <span class="k end"><kbd>{t('key.esc')}</kbd> {t('demo.dismiss')}</span>
    </div>
  </div>
</Moment>

<Moment k="windows" id="windows" band>
  <div class="ov big" id="mWin" aria-hidden="true">
    <div class="q"><Fragment set:html={glass} /><span class="typed ph" id="mWinQ" data-ph={t('demo.placeholder')}>{t('demo.placeholder')}</span></div>
    <ul id="mWinRows"></ul>
    <div class="foot">
      <span class="k"><kbd>↑</kbd><kbd>↓</kbd> {t('demo.navigate')}</span>
      <span class="k"><kbd>↵</kbd> {t('demo.open')}</span>
      <span class="k"><kbd>{t('key.ctrl')}</kbd><kbd>⌫</kbd> {t('demo.closeTab')}</span>
      <span class="k"><kbd>/</kbd> {t('demo.scopes')}</span>
      <span class="k end"><kbd>{t('key.esc')}</kbd> {t('demo.dismiss')}</span>
    </div>
  </div>
  <div class="menu" id="mWinMenu" aria-hidden="true">
    <div class="on"><code>/t</code>{t('scopes.tabs')}</div>
    <div><code>/b</code>{t('scopes.bookmarks')}<span>{t('scopes.optIn')}</span></div>
    <div><code>/h</code>{t('scopes.history')}<span>{t('scopes.optIn')}</span></div>
  </div>
</Moment>

<Moment k="back" id="back">
  <div class="browser" id="mBack" aria-hidden="true">
    <div class="strip" id="mBackTabs"></div>
    <div class="page" id="mBackPage"></div>
  </div>
  <div class="press" id="mBackKeys" aria-hidden="true"><kbd>{t('key.alt')}</kbd><kbd>Z</kbd></div>
</Moment>
<Moment k="themes" id="themes" band>
  <div class="themes" id="themesBox">
    {['light', 'dark'].map((theme) => (
      <div class="canvas" data-theme={theme}>
        <div class="cap">{t(`themes.${theme}`)}</div>
        <div class="backdrop" aria-hidden="true"></div>
        <div class="ov" data-static>
          <div class="q"><Fragment set:html={glass} /><span style="flex:1">{'gh pr'}</span><span class="n"></span></div>
          <ul></ul>
          <div class="foot">
            <span class="k"><kbd>↑</kbd><kbd>↓</kbd> {t('demo.navigate')}</span>
            <span class="k"><kbd>↵</kbd> {t('demo.open')}</span>
            <span class="k end"><kbd>{t('key.esc')}</kbd> {t('demo.dismiss')}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="opts" id="opts">
    <div class="opt"><div class="top"><label for="o-opacity">{t('themes.opacity')}</label><output id="o-opacity-v"></output></div><input id="o-opacity" type="range" min="60" max="100" step="2" value="86" /></div>
    <div class="opt"><div class="top"><label for="o-blur">{t('themes.blur')}</label><output id="o-blur-v"></output></div><input id="o-blur" type="range" min="0" max="40" step="2" value="24" /></div>
    <div class="opt"><div class="top"><label for="o-size">{t('themes.size')}</label><output id="o-size-v"></output></div><input id="o-size" type="range" min="70" max="150" step="5" value="100" /></div>
    <button class="btn ghost" id="o-reset" type="button">{t('themes.reset')}</button>
  </div>
</Moment>

---
import { useT } from '../i18n/index.js';
const { t } = useT(Astro.currentLocale);
---

<section class="s" id="themes">
  <div class="wrap"><div class="row">
    <div class="lab">{t('themes.label')}</div>
    <div>
      <h2>{t('themes.titleA')} <em>{t('themes.titleB')}</em></h2>
      <p class="lead" set:html={t('themes.lead')} />
      <div class="opts" id="opts">
        <div class="opt"><div class="top"><label for="o-opacity">{t('themes.opacity')}</label><output id="o-opacity-v"></output></div><input id="o-opacity" type="range" min="60" max="100" step="2" value="86" /><span class="hint2">{t('themes.opacityHint')}</span></div>
        <div class="opt"><div class="top"><label for="o-blur">{t('themes.blur')}</label><output id="o-blur-v"></output></div><input id="o-blur" type="range" min="0" max="40" step="2" value="24" /><span class="hint2">{t('themes.blurHint')}</span></div>
        <div class="opt"><div class="top"><label for="o-size">{t('themes.size')}</label><output id="o-size-v"></output></div><input id="o-size" type="range" min="70" max="150" step="5" value="100" /><span class="hint2">{t('themes.sizeHint')}</span></div>
        <button class="btn ghost" id="o-reset" type="button">{t('themes.reset')}</button>
      </div>
      <div class="themes" id="themesBox">
        {['light', 'dark'].map((theme) => (
          <div class="canvas" data-theme={theme}>
            <div class="cap">{t(`themes.${theme}`)}</div>
            <div class="backdrop" aria-hidden="true"></div>
            <div class="ov" data-static>
              <div class="q">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <span style="flex:1">gh pr</span><span class="n"></span>
              </div>
              <ul></ul>
              <div class="foot">
                <span class="k"><kbd>↑</kbd><kbd>↓</kbd> {t('demo.navigate')}</span>
                <span class="k"><kbd>↵</kbd> {t('demo.open')}</span>
                <span class="k end"><kbd>{t('key.esc')}</kbd> {t('demo.dismiss')}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div></div>
</section>

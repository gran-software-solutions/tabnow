---
import { useT } from '../i18n/index.js';
import { install } from '../config.js';
import InstallButton from './InstallButton.astro';
const { t, list } = useT(Astro.currentLocale);
const { soon } = install();
---

<section class="moment closing" id="install">
  <div class="wrap">
    <h2 data-reveal>{t('installSection.titleA')} <em>{t('installSection.titleB')}</em></h2>
    <div class="go-btn" data-reveal><InstallButton /></div>
    <ol class="steps" data-reveal>
      {list('installSection.steps').map((step) => <li><span set:html={step} /></li>)}
    </ol>
    <p class="mac">{soon ? t('installSection.leadSoon') : t('installSection.lead')}</p>
  </div>
</section>

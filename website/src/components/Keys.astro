---
import { useT } from '../i18n/index.js';
const { t, list } = useT(Astro.currentLocale);
---

<section class="s" id="keys">
  <div class="wrap"><div class="row">
    <div class="lab">{t('keys.label')}</div>
    <div>
      <h2>{t('keys.titleA')} <em>{t('keys.titleB')}</em></h2>
      <p class="lead">{t('keys.lead')}</p>
      <div class="keys">
        {list('keys.items').map((item) => (
          <div><span class="kk">{item.keys.map((k) => <kbd>{k}</kbd>)}</span><span class="d">{item.text}</span></div>
        ))}
      </div>
    </div>
  </div></div>
</section>

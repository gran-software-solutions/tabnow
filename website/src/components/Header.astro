---
import { useT, localePath } from '../i18n/index.js';
import InstallButton from './InstallButton.astro';
const { home = false } = Astro.props;
const { t, locale } = useT(Astro.currentLocale);
import { BRAND } from '../config.js';
const base = home ? '' : localePath(locale, '/');
---

<nav aria-label={t('a11y.nav')}>
  <a class="logo" href={home ? '#top' : localePath(locale, '/')}><img src="/icon-128.png" alt="" width="24" height="24" />{BRAND}</a>
  <a class="l" href={`${base}#features`}>{t('nav.features')}</a>
  <a class="l" href={`${base}#keys`}>{t('nav.keys')}</a>
  <a class="l" href={`${base}#themes`}>{t('nav.themes')}</a>
  <a class="l" href={`${base}#privacy`}>{t('nav.privacy')}</a>
  <button
    class="sw"
    type="button"
    data-theme-toggle
    data-to-dark={t('theme.toDark')}
    data-to-light={t('theme.toLight')}
    title={t('theme.title')}
    aria-label={t('theme.toDark')}
  >
    <svg class="sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    <svg class="moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg>
  </button>
  <InstallButton short />
</nav>

<script>
  import '../scripts/theme.js';
</script>
